{
	"schemaVersion": 1,
	"id": "bartershop",
	"version": "${version}",
	"name": "BarterShop",
	"description": "BarterShop is a lightweight, server-friendly chest shop mod that lets players buy and sell items using simple signs and item-based trades. Create secure shops without commands, complicated setups, or a client-side installation.",
	"authors": [
		"Siskin"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/bartershop",
		"sources": "https://github.com/luuknijkmp/BarterShop",
		"issues": "https://github.com/luuknijkmp/BarterShop/issues"
	},
	"license": "MIT",
	"icon": "assets/bartershop/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.siskin.bartershop.BarterShop"
		],
		"client": [
		]
	},
	"mixins": [
		"bartershop.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}